---
import Page from './Page.astro';

interface Props {
	eyebrow: string;
	title: string;
	description: string;
}

const { eyebrow, title, description } = Astro.props;
---

<Page title={`${title} — HippOS`} description={description}>
	<main class="mx-auto max-w-4xl px-5 py-16">
		<header class="mb-12">
			<p class="mb-3 text-sm font-bold uppercase tracking-[0.24em] text-hippo-blue">{eyebrow}</p>
			<h1 class="mb-4 text-4xl font-bold uppercase text-white md:text-5xl">{title}</h1>
			<p class="text-xl text-hippo-silver">{description}</p>
		</header>
		<div class="prose">
			<slot />
		</div>
	</main>
</Page>
