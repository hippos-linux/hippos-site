---
export const prerender = false;

import Page from '../layouts/Page.astro';
import DiscordSignIn from '../components/DiscordSignIn.astro';
import ImageDownload from '../components/ImageDownload.astro';
import { IMAGES } from '../data/images';
import { hasDownloadAccess } from '../lib/download-access';
import { readStableManifest } from '../lib/manifest';

const env = Astro.locals.runtime?.env;
const canDownload = await hasDownloadAccess(env, Astro.cookies);
const manifest = await readStableManifest(env?.HIPPOS_IMAGES);
---

<Page title="Download — HippOS" description="Download the HippOS image for your PC, handheld or Raspberry Pi.">
	<main class="mx-auto max-w-6xl px-5 py-16">
		<header class="mb-12 max-w-3xl">
			<p class="mb-3 text-sm font-bold uppercase tracking-[0.24em] text-hippo-blue">
				Download{manifest && <> · v{manifest.version}</>}
			</p>
			<h1 class="mb-4 text-4xl font-bold uppercase text-white md:text-5xl">Get HippOS</h1>
			<p class="text-xl text-hippo-silver">
				Pick the image for your hardware. Each link always points at the latest beta. The
				<a href="/install">install guide</a> covers writing it to a drive and the first boot.
			</p>
		</header>

		{!canDownload && <div class="mb-12"><DiscordSignIn /></div>}

		<div class="grid gap-6 md:grid-cols-3">
			{IMAGES.map((image) => (
				<section id={image.target} class="flex flex-col overflow-hidden border border-white/10 bg-white/[0.03]">
					<div class="bg-gradient-to-br from-hippo-violet/15 to-hippo-blue/10 p-6">
						<img class="mx-auto block w-full max-w-xs" src={image.illustration} width="320" height="240" alt="" />
					</div>
					<div class="flex flex-1 flex-col p-5 md:p-6">
						<div class="mb-3 flex flex-wrap items-center gap-3">
							<h2 class="text-xl font-bold text-white">{image.title}</h2>
							{image.experimental && (
								<span class="rounded-full bg-hippo-violet/20 px-3 py-0.5 text-xs font-bold uppercase tracking-[0.14em] text-hippo-silver ring-1 ring-hippo-violet/40">
									Experimental
								</span>
							)}
						</div>
						<p class="mb-2 text-hippo-silver">{image.summary}</p>
						<p class="mb-6 text-sm text-hippo-steel">{image.media}</p>
						<div class="mt-auto">
							{canDownload ? (
								<ImageDownload target={image.target} />
							) : (
								<span class="text-sm text-hippo-steel">Sign in with Discord above to download.</span>
							)}
						</div>
					</div>
				</section>
			))}
		</div>
	</main>
</Page>
