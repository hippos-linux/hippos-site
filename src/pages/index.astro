---
export const prerender = false;

import Page from '../layouts/Page.astro';
import DiscordIcon from '../components/DiscordIcon.astro';
import FeatureCard from '../components/FeatureCard.astro';
import FormattedDate from '../components/FormattedDate.astro';
import { readStableManifest } from '../lib/manifest';
import { releasesNewestFirst } from '../lib/releases';
import { emulatorsFromManifest } from '../data/emulators';
import { GITHUB_URL } from '../consts';
import ClipVideo from '../components/ClipVideo.astro';
import { CLIPS } from '../data/clips';
import netplayLobby from '../assets/gallery/netplay-lobby.webp';

const manifest = await readStableManifest(Astro.locals.runtime?.env?.HIPPOS_IMAGES);
const emulators = manifest ? emulatorsFromManifest(Object.keys(manifest.payloads.emulators)) : [];

const [latestRelease] = await releasesNewestFirst();

const featuredEmulators = emulators.filter(({ featured }) => featured);
const otherEmulators = emulators.filter(({ featured }) => !featured);

const sectionLabel = 'mb-3 text-sm font-bold uppercase tracking-[0.24em] text-hippo-blue';
const sectionTitle = 'mb-4 text-3xl font-bold text-white md:text-4xl';
const sectionBody = 'mb-10 max-w-2xl text-lg text-hippo-silver';
---

<Page
	title="HippOS Linux — Built to Play"
	description="A Debian-based gaming OS for handhelds and living-room PCs. Controller-first, dozens of emulators built from source, and a full Linux gaming stack."
>
	<section class="relative overflow-hidden">
		<div class="absolute inset-0 bg-[url('/hippos-wallpaper-lake.png')] bg-cover bg-center opacity-15" aria-hidden="true"></div>
		<div class="absolute inset-0 bg-gradient-to-b from-transparent to-void-950" aria-hidden="true"></div>
		<div class="relative mx-auto grid max-w-6xl items-center gap-12 px-5 pb-16 pt-10 md:pt-16 lg:grid-cols-[minmax(0,5fr)_minmax(0,7fr)]">
			<div class="text-center lg:text-left">
				<img class="mb-6 hidden w-full max-w-[12rem] mix-blend-lighten lg:block" src="/hippos-logo-with-text.png" alt="HippOS Linux" />
				<span class="mb-6 inline-block rounded-full bg-white/5 px-4 py-1 text-sm font-bold uppercase tracking-[0.18em] text-hippo-silver ring-1 ring-white/10">
					Early access{manifest && <> · v{manifest.version}</>}
				</span>
				<h1 class="mb-5 text-4xl font-bold text-white md:text-5xl">Switch on. Pick a game. Play.</h1>
				<p class="mb-8 text-lg text-hippo-silver md:text-xl">
					A Debian-based gaming OS for handhelds and living-room PCs. Boots straight into EmulationStation, with
					dozens of emulators, a full Linux gaming stack, and a desktop one button away.
				</p>
				<div class="flex flex-wrap items-center justify-center gap-x-6 gap-y-4 lg:justify-start">
					<a class="inline-flex items-center justify-center gap-2 rounded-full bg-hippo-blue px-8 py-3 font-bold text-white no-underline transition hover:bg-hippo-violet hover:text-white" href="/download">
						<svg width="16" height="16" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
							<path d="M8 11.5L3.5 7H6.5V2H9.5V7H12.5L8 11.5Z" />
							<rect x="2" y="13" width="12" height="1.5" rx="0.75" />
						</svg>
						Download
					</a>
					<a class="text-sm font-semibold text-hippo-silver no-underline hover:text-white" href="/install">Install guide →</a>
				</div>
			</div>
			<div id="clip-hero" class="overflow-hidden rounded-xl shadow-2xl shadow-hippo-violet/30 ring-1 ring-white/15">
				<ClipVideo clip={CLIPS[0]} slot={0} />
			</div>
		</div>
		<div class="relative mx-auto max-w-6xl px-5 pb-8">
			<ul class="-mx-5 flex list-none snap-x snap-mandatory gap-4 overflow-x-auto px-5 pb-2 [scrollbar-width:none] md:mx-0 md:grid md:grid-cols-3 md:gap-5 md:overflow-visible md:px-0 md:pb-0">
				{CLIPS.slice(1).map((clip, index) => (
					<li class="w-[80%] shrink-0 snap-center md:w-auto">
						<button type="button" class="clip-card group block w-full cursor-pointer text-left" data-slot={index + 1} aria-label={`Play ${clip.title} above`}>
							<span class="mb-3 block overflow-hidden rounded-lg ring-1 ring-white/10 transition group-hover:ring-hippo-blue/60">
								<ClipVideo clip={clip} slot={index + 1} />
							</span>
							<strong class="block text-white" data-clip-title>{clip.title}</strong>
							<span class="text-sm text-hippo-silver" data-clip-caption>{clip.caption}</span>
						</button>
					</li>
				))}
			</ul>
			<p class="mt-6 text-center md:text-right">
				<a class="text-sm font-semibold" href="/gallery">More screenshots in the gallery →</a>
			</p>
		</div>
	</section>

	<main class="mx-auto max-w-6xl space-y-24 px-5 py-20 md:py-24">
		<section>
			<p class={sectionLabel}>The OS</p>
			<h2 class={sectionTitle}>A gaming appliance, not a distro with a launcher.</h2>
			<p class={sectionBody}>
				HippOS is built on a clean Debian base and ships as a ready-to-run image. Flash it and play. There's nothing to
				set up first.
			</p>
			<div class="grid gap-5 md:grid-cols-3">
				<FeatureCard icon="🎮" title="Controller-first">
					Boots directly into EmulationStation. Everything is reachable from a gamepad, so you never need a keyboard or mouse.
				</FeatureCard>
				<FeatureCard icon="🧱" title="Built from source">
					Every emulator is compiled from upstream source and ships with its own runtime libraries, so there are no dependency conflicts.
				</FeatureCard>
				<FeatureCard icon="🔄" title="Safe updates">
					Over-the-air updates replace the OS and leave your games, saves and settings alone. If one goes wrong, you can roll back.
				</FeatureCard>
			</div>
		</section>

		{
			emulators.length > 0 && (
				<section>
					<p class={sectionLabel}>Emulation</p>
					<h2 class={sectionTitle}>{emulators.length} emulators and engines, ready to go.</h2>
					<p class={sectionBody}>
						This is the exact set in the current release. RetroArch adds dozens more systems through libretro cores.
					</p>
					<ul class="flex list-none flex-wrap gap-2 p-0">
						{featuredEmulators.map(({ name }) => (
							<li class="rounded-full bg-hippo-blue/15 px-4 py-1.5 text-sm font-semibold text-white ring-1 ring-hippo-blue/40">{name}</li>
						))}
					</ul>
					{otherEmulators.length > 0 && (
						<details class="mt-4">
							<summary class="cursor-pointer text-sm font-semibold text-hippo-blue">Show all {emulators.length}</summary>
							<ul class="mt-4 flex list-none flex-wrap gap-2 p-0">
								{otherEmulators.map(({ name }) => (
									<li class="rounded-full bg-white/5 px-4 py-1.5 text-sm font-semibold text-hippo-silver ring-1 ring-white/10">{name}</li>
								))}
							</ul>
						</details>
					)}
				</section>
			)
		}

		<section>
			<p class={sectionLabel}>Beyond emulation</p>
			<h2 class={sectionTitle}>Your whole library in one place.</h2>
			<p class={sectionBody}>
				PC games, Android apps and network storage sit next to your emulators, all launched from the same frontend.
			</p>
			<div class="grid gap-5 md:grid-cols-2 lg:grid-cols-3">
				<FeatureCard icon="🎲" title="Steam">
					Your installed Steam games appear in EmulationStation as their own system, with no desktop needed.
				</FeatureCard>
				<FeatureCard icon="🍷" title="Wine & Lutris">
					Windows games and installers show up in EmulationStation like everything else.
				</FeatureCard>
				<FeatureCard icon="🤖" title="Android apps">
					Waydroid runs Android apps with controller input routed correctly, right next to your emulators.
				</FeatureCard>
				<FeatureCard icon="📦" title="Flatpak apps">
					The HippOS Store gives you Flathub, Debian, recomps and HippOS picks in one place, without a terminal.
				</FeatureCard>
				<FeatureCard icon="💾" title="Storage pools">
					Plug in more drives and HippOS merges their ROMs, BIOS and saves into one library automatically.
				</FeatureCard>
				<FeatureCard icon="🌐" title="Network sharing">
					Drop games in from any machine on your LAN over Samba.
				</FeatureCard>
			</div>
		</section>

		<section class="grid items-center gap-10 lg:grid-cols-2">
			<div>
				<p class={sectionLabel}>Play together</p>
				<h2 class={sectionTitle}>Find a game, say hello, press A.</h2>
				<p class="mb-6 text-lg text-hippo-silver">
					The netplay lobby lists online games from HippOS players, RetroArch, Dolphin and Riverhorse, next to a chat.
					Games are grouped by system and only show when you have the game.
				</p>
				<ul class="mb-6 space-y-2 text-hippo-silver">
					<li><strong class="text-white">Join with one press.</strong> HippOS starts the right emulator with the right settings.</li>
					<li><strong class="text-white">Chat while you wait.</strong> A global room plus one per system.</li>
					<li><strong class="text-white">Host and wait.</strong> Accept each player, or let them straight in.</li>
				</ul>
				<a class="font-bold" href="/docs/netplay/">How netplay works →</a>
			</div>
			<a class="block overflow-hidden rounded-xl ring-1 ring-white/15" href="/gallery">
				<img class="block w-full" src={netplayLobby.src} width={netplayLobby.width} height={netplayLobby.height} alt="The HippOS netplay lobby" loading="lazy" />
			</a>
		</section>

		<section>
			<p class={sectionLabel}>Hardware & input</p>
			<h2 class={sectionTitle}>Handles the hardware, so you don't have to.</h2>
			<p class={sectionBody}>
				AMD, Intel and NVIDIA graphics, including legacy NVIDIA cards, plus handheld TDP control, arcade encoders and CRTs.
				<a href="/hardware">See what's supported →</a>
			</p>
			<div class="grid gap-5 md:grid-cols-3">
				<FeatureCard icon="⚡" title="Handhelds">
					TDP control for Steam Deck, ROG Ally, Legion Go, AYANEO and other AMD handhelds, with working brightness and volume hotkeys.
				</FeatureCard>
				<FeatureCard icon="🕹️" title="Arcade & CRT">
					Pad2Key remaps IPAC, X-Arcade and JammaSD encoders. Switchres drives CRTs with generated modelines.
				</FeatureCard>
				<FeatureCard icon="🖥️" title="Desktop mode">
					Press F1 for a full Linux desktop, and log out to return to your games.
				</FeatureCard>
			</div>
		</section>

		{
			latestRelease && (
				<section class="border border-white/10 bg-gradient-to-br from-hippo-violet/15 to-hippo-blue/10 p-5 md:p-10">
					<p class={sectionLabel}>
						Latest release · <FormattedDate date={latestRelease.data.date} />
					</p>
					<h2 class={sectionTitle}>HippOS {latestRelease.data.version}</h2>
					<p class="mb-6 max-w-2xl text-lg text-hippo-silver">{latestRelease.data.summary}</p>
					<a class="font-bold" href={`/changelog#v${latestRelease.data.version}`}>Read the release notes →</a>
				</section>
			)
		}

		<section>
			<p class={sectionLabel}>Get involved</p>
			<h2 class={sectionTitle}>Looking for testers and developers.</h2>
			<p class={sectionBody}>
				HippOS is a small project with a lot of ground to cover, and every release is shaped by reports from the Discord. If
				you want to help, jump in.
			</p>
			<div class="mb-8 grid gap-5 md:grid-cols-2">
				<FeatureCard icon="🧪" title="Testers">
					Flash the image on your hardware and report what breaks. Hardware compatibility, emulator launches, controller
					detection and first-boot behaviour all need testing on as many machines as possible.
				</FeatureCard>
				<FeatureCard icon="👾" title="Developers">
					The stack is Debian, Bash, Python and a C++ EmulationStation fork. The areas that need the most work are emulator
					configuration, controller support, the theme and the update system. Open an issue or PR on GitHub.
				</FeatureCard>
			</div>
			<div class="flex flex-wrap gap-4">
				<a class="inline-flex items-center gap-2 rounded-full bg-[#5865f2] px-6 py-3 font-bold text-white no-underline hover:bg-[#4752c4] hover:text-white" href="/discord">
					<DiscordIcon /> Join the Discord
				</a>
				<a class="inline-flex items-center rounded-full bg-white/5 px-6 py-3 font-bold text-white no-underline ring-1 ring-white/15 hover:bg-white/10 hover:text-white" href={GITHUB_URL}>
					View on GitHub
				</a>
			</div>
		</section>
	</main>
	<script>
		import { CLIPS, clipSources } from '../data/clips';

		const videos = [...document.querySelectorAll<HTMLVideoElement>('video.clip-video')].sort(
			(a, b) => Number(a.dataset.slot) - Number(b.dataset.slot),
		);
		const cards = new Map([...document.querySelectorAll<HTMLButtonElement>('button.clip-card')].map((card) => [Number(card.dataset.slot), card]));
		const order = CLIPS.map((_, index) => index);
		const connection = (navigator as Navigator & { connection?: { saveData?: boolean } }).connection;
		const stillsOnly = matchMedia('(prefers-reduced-motion: reduce)').matches || Boolean(connection?.saveData);
		const visibility = new Map<HTMLVideoElement, number>();

		function showClip(slot: number) {
			const clip = CLIPS[order[slot]];
			const { webm, mp4, poster } = clipSources(clip.id);
			const video = videos[slot];
			video.poster = poster;
			video.querySelector<HTMLSourceElement>('source[type="video/webm"]')!.src = webm;
			video.querySelector<HTMLSourceElement>('source[type="video/mp4"]')!.src = mp4;
			video.setAttribute('aria-label', clip.title);
			video.load();
			const card = cards.get(slot);
			if (card) {
				card.querySelector('[data-clip-title]')!.textContent = clip.title;
				card.querySelector('[data-clip-caption]')!.textContent = clip.caption;
				card.setAttribute('aria-label', `Play ${clip.title} above`);
			}
		}

		function playMostVisible() {
			if (stillsOnly) return;
			let best: HTMLVideoElement | undefined;
			for (const [video, ratio] of visibility) {
				if (ratio >= 0.5 && (!best || ratio > visibility.get(best)!)) best = video;
			}
			for (const video of videos) {
				if (video === best) video.play().catch(() => {});
				else video.pause();
			}
		}

		const observer = new IntersectionObserver(
			(entries) => {
				for (const entry of entries) visibility.set(entry.target as HTMLVideoElement, entry.intersectionRatio);
				playMostVisible();
			},
			{ threshold: [0, 0.5, 0.75, 1] },
		);
		videos.forEach((video) => observer.observe(video));

		for (const [slot, card] of cards) {
			card.addEventListener('click', () => {
				[order[0], order[slot]] = [order[slot], order[0]];
				showClip(0);
				showClip(slot);
				const hero = document.getElementById('clip-hero')!;
				if (hero.getBoundingClientRect().top < 0) hero.scrollIntoView({ behavior: 'smooth', block: 'center' });
				visibility.set(videos[slot], 0);
				visibility.set(videos[0], 1);
				playMostVisible();
			});
		}
	</script>
</Page>
