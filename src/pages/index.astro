---
export const prerender = false;

import { getCollection } from 'astro:content';
import Page from '../layouts/Page.astro';
import DownloadGate from '../components/DownloadGate.astro';
import DiscordIcon from '../components/DiscordIcon.astro';
import FeatureCard from '../components/FeatureCard.astro';
import FormattedDate from '../components/FormattedDate.astro';
import { readStableManifest } from '../lib/manifest';
import { emulatorsFromManifest } from '../data/emulators';
import { GITHUB_URL } from '../consts';

const manifest = await readStableManifest(Astro.locals.runtime?.env?.HIPPOS_IMAGES);
const emulators = manifest ? emulatorsFromManifest(Object.keys(manifest.payloads.emulators)) : [];

const [latestRelease] = (await getCollection('releases')).sort(
	(a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);

const sectionLabel = 'mb-3 text-sm font-bold uppercase tracking-[0.24em] text-hippo-blue';
const sectionTitle = 'mb-4 text-3xl font-bold text-white md:text-4xl';
const sectionBody = 'mb-10 max-w-2xl text-lg text-hippo-silver';
---

<Page
	title="HippOS Linux — Built to Play"
	description="A Debian-based gaming OS for handhelds and living-room PCs. Controller-first, dozens of emulators built from source, and a full Linux gaming stack."
>
	<section class="relative overflow-hidden">
		<div class="absolute inset-0 bg-[url('/hippos-wallpaper-lake.png')] bg-cover bg-center opacity-15" aria-hidden="true"></div>
		<div class="absolute inset-0 bg-gradient-to-b from-transparent to-void-950" aria-hidden="true"></div>
		<div class="relative mx-auto flex max-w-4xl flex-col items-center px-5 pb-20 pt-16 text-center md:pt-24">
			<img class="mb-6 w-full max-w-xs mix-blend-lighten" src="/hippos-logo-with-text.png" alt="HippOS Linux" />
			<span class="mb-6 rounded-full bg-white/5 px-4 py-1 text-sm font-bold uppercase tracking-[0.18em] text-hippo-silver ring-1 ring-white/10">
				Public beta{manifest && <> · v{manifest.version}</>}
			</span>
			<p class="mb-10 max-w-2xl text-xl text-hippo-silver">
				A Debian-based gaming OS for handhelds and living-room PCs. Boots straight into EmulationStation, with
				dozens of emulators, a full Linux gaming stack, and a desktop one button away.
			</p>
			<DownloadGate />
			<div class="mt-8 flex flex-wrap justify-center gap-6 text-sm font-semibold">
				<a class="text-hippo-silver no-underline hover:text-white" href="/install">Install guide →</a>
				<a class="text-hippo-silver no-underline hover:text-white" href="/hardware">Supported hardware →</a>
				<a class="text-hippo-silver no-underline hover:text-white" href="/changelog">What's new →</a>
			</div>
		</div>
	</section>

	<main class="mx-auto max-w-6xl space-y-24 px-5 py-20">
		<section>
			<p class={sectionLabel}>The OS</p>
			<h2 class={sectionTitle}>A gaming appliance, not a distro with a launcher.</h2>
			<p class={sectionBody}>
				HippOS is built on a clean Debian base and ships as a ready-to-run image. Flash it and play. There's nothing to
				set up first.
			</p>
			<div class="grid gap-5 md:grid-cols-3">
				<FeatureCard icon="🎮" title="Controller-first">
					Boots directly into EmulationStation. Everything is reachable from a gamepad, so you never need a keyboard or mouse.
				</FeatureCard>
				<FeatureCard icon="🧱" title="Built from source">
					Every emulator is compiled from upstream source and ships with its own runtime libraries, so there are no dependency conflicts.
				</FeatureCard>
				<FeatureCard icon="🔄" title="Safe updates">
					Over-the-air updates replace the OS and leave your games, saves and settings alone. If one goes wrong, you can roll back.
				</FeatureCard>
			</div>
		</section>

		{
			emulators.length > 0 && (
				<section>
					<p class={sectionLabel}>Emulation</p>
					<h2 class={sectionTitle}>{emulators.length} emulators and engines, ready to go.</h2>
					<p class={sectionBody}>
						This is the exact set in the current release. RetroArch adds dozens more systems through libretro cores.
					</p>
					<ul class="flex list-none flex-wrap gap-2 p-0">
						{emulators.map(({ name, featured }) => (
							<li
								class:list={[
									'rounded-full px-4 py-1.5 text-sm font-semibold ring-1',
									featured ? 'bg-hippo-blue/15 text-white ring-hippo-blue/40' : 'bg-white/5 text-hippo-silver ring-white/10',
								]}
							>
								{name}
							</li>
						))}
					</ul>
				</section>
			)
		}

		<section>
			<p class={sectionLabel}>Beyond emulation</p>
			<h2 class={sectionTitle}>Your whole library in one place.</h2>
			<p class={sectionBody}>
				PC games, Android apps and network storage sit next to your emulators, all launched from the same frontend.
			</p>
			<div class="grid gap-5 md:grid-cols-2 lg:grid-cols-3">
				<FeatureCard icon="🎲" title="Steam">
					Your installed Steam games appear in EmulationStation as their own system, with no desktop needed.
				</FeatureCard>
				<FeatureCard icon="🍷" title="Wine & Lutris">
					Windows games and installers show up in EmulationStation like everything else.
				</FeatureCard>
				<FeatureCard icon="🤖" title="Android apps">
					Waydroid runs Android apps with controller input routed correctly, right next to your emulators.
				</FeatureCard>
				<FeatureCard icon="📦" title="Flatpak apps">
					Bazaar gives you the full Flathub catalogue without a terminal.
				</FeatureCard>
				<FeatureCard icon="💾" title="Storage pools">
					Plug in more drives and HippOS merges their ROMs, BIOS and saves into one library automatically.
				</FeatureCard>
				<FeatureCard icon="🌐" title="Network sharing">
					Drop games in from any machine on your LAN over Samba.
				</FeatureCard>
			</div>
		</section>

		<section>
			<p class={sectionLabel}>Hardware & input</p>
			<h2 class={sectionTitle}>Handles the hardware, so you don't have to.</h2>
			<p class={sectionBody}>
				AMD, Intel and NVIDIA graphics, including legacy NVIDIA cards, plus handheld TDP control, arcade encoders and CRTs.
				<a href="/hardware">See what's supported →</a>
			</p>
			<div class="grid gap-5 md:grid-cols-3">
				<FeatureCard icon="⚡" title="Handhelds">
					TDP control for Steam Deck, ROG Ally, Legion Go, AYANEO and other AMD handhelds, with working brightness and volume hotkeys.
				</FeatureCard>
				<FeatureCard icon="🕹️" title="Arcade & CRT">
					Pad2Key remaps IPAC, X-Arcade and JammaSD encoders. Switchres drives CRTs with generated modelines.
				</FeatureCard>
				<FeatureCard icon="🖥️" title="Desktop mode">
					Press F1 for a full Linux desktop, and log out to return to your games.
				</FeatureCard>
			</div>
		</section>

		{
			latestRelease && (
				<section class="border border-white/10 bg-gradient-to-br from-hippo-violet/15 to-hippo-blue/10 p-8 md:p-10">
					<p class={sectionLabel}>
						Latest release · <FormattedDate date={latestRelease.data.date} />
					</p>
					<h2 class={sectionTitle}>HippOS {latestRelease.data.version}</h2>
					<p class="mb-6 max-w-2xl text-lg text-hippo-silver">{latestRelease.data.summary}</p>
					<a class="font-bold" href={`/changelog#v${latestRelease.data.version}`}>Read the release notes →</a>
				</section>
			)
		}

		<section>
			<p class={sectionLabel}>Get involved</p>
			<h2 class={sectionTitle}>Built with its beta testers.</h2>
			<p class={sectionBody}>
				Every release is shaped by reports from the Discord. Flash it on your hardware, tell us what breaks, or dig into the
				code. It's Debian, Bash, Python and a C++ EmulationStation fork.
			</p>
			<div class="flex flex-wrap gap-4">
				<a class="inline-flex items-center gap-2 rounded-full bg-[#5865f2] px-6 py-3 font-bold text-white no-underline hover:bg-[#4752c4] hover:text-white" href="/discord">
					<DiscordIcon /> Join the Discord
				</a>
				<a class="inline-flex items-center rounded-full bg-white/5 px-6 py-3 font-bold text-white no-underline ring-1 ring-white/15 hover:bg-white/10 hover:text-white" href={GITHUB_URL}>
					View on GitHub
				</a>
			</div>
		</section>
	</main>
</Page>
