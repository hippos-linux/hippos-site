---
import HeaderLink from './HeaderLink.astro';
import { SITE_TITLE, NAV_LINKS } from '../consts';
---

<header>
	<nav class="mx-auto flex max-w-6xl items-center justify-between gap-6 px-5 py-3 md:py-4">
		<a class="flex items-center gap-3 text-white no-underline" href="/">
			<img class="size-9 object-contain mix-blend-lighten md:size-11" src="/hippos-logo.png" width="1254" height="1254" alt="" />
			<span class="text-lg font-bold uppercase tracking-[0.08em] md:text-xl">{SITE_TITLE}</span>
		</a>
		<div class="hidden items-center gap-1 rounded-full bg-white/5 p-1 text-sm font-semibold shadow-sm ring-1 ring-white/10 lg:flex">
			{
				NAV_LINKS.map(({ href, label }) => (
					<HeaderLink class="whitespace-nowrap rounded-full px-4 py-2 text-hippo-silver hover:bg-white/10 hover:text-white" href={href}>
						{label}
					</HeaderLink>
				))
			}
		</div>
		<details class="menu relative lg:hidden">
			<summary class="flex size-11 cursor-pointer list-none items-center justify-center rounded-full bg-white/5 text-white ring-1 ring-white/10" aria-label="Menu">
				<svg class="size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
					<path d="M4 7h16M4 12h16M4 17h16" />
				</svg>
			</summary>
			<div class="absolute right-0 mt-2 flex w-56 flex-col gap-1 rounded-2xl bg-[#0b0d18] p-2 text-base font-semibold shadow-xl ring-1 ring-white/10">
				{
					NAV_LINKS.map(({ href, label }) => (
						<HeaderLink class="rounded-xl px-4 py-3 text-hippo-silver hover:bg-white/10 hover:text-white" href={href}>
							{label}
						</HeaderLink>
					))
				}
			</div>
		</details>
	</nav>
</header>
<script is:inline>
	document.addEventListener('click', (event) => {
		const menu = document.querySelector('header details.menu');
		if (menu?.open && !menu.contains(event.target)) menu.open = false;
	});
</script>
<style>
	summary::-webkit-details-marker {
		display: none;
	}
	header {
		background: rgba(3, 4, 10, 0.72);
		backdrop-filter: blur(16px);
		border-bottom: 1px solid rgba(199, 203, 212, 0.1);
		position: sticky;
		top: 0;
		z-index: 20;
	}
</style>
