---
import HeaderLink from './HeaderLink.astro';
import { SITE_TITLE, NAV_LINKS } from '../consts';
---

<header>
	<nav class="mx-auto flex max-w-6xl flex-wrap items-center justify-between gap-x-6 gap-y-3 px-5 py-4">
		<a class="flex items-center gap-3 text-white no-underline" href="/">
			<img class="size-11 object-contain mix-blend-lighten" src="/hippos-logo.png" width="1254" height="1254" alt="" />
			<span class="text-xl font-bold uppercase tracking-[0.08em]">{SITE_TITLE}</span>
		</a>
		<div class="flex max-w-full items-center gap-1 overflow-x-auto rounded-full bg-white/5 p-1 text-sm font-semibold shadow-sm ring-1 ring-white/10">
			{
				NAV_LINKS.map(({ href, label }) => (
					<HeaderLink class="whitespace-nowrap rounded-full px-4 py-2 text-hippo-silver hover:bg-white/10 hover:text-white" href={href}>
						{label}
					</HeaderLink>
				))
			}
		</div>
	</nav>
</header>
<style>
	header {
		background: rgba(3, 4, 10, 0.72);
		backdrop-filter: blur(16px);
		border-bottom: 1px solid rgba(199, 203, 212, 0.1);
		position: sticky;
		top: 0;
		z-index: 20;
	}
</style>
