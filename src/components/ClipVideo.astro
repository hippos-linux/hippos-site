---
import { clipSources, type Clip } from '../data/clips';

interface Props {
	clip: Clip;
	slot: number;
	class?: string;
}

const { clip, slot, class: className } = Astro.props;
const { webm, mp4, poster } = clipSources(clip.id);
---

<video
	class:list={['clip-video block aspect-video w-full bg-black', className]}
	data-slot={slot}
	muted
	loop
	playsinline
	preload="none"
	poster={poster}
	width="1280"
	height="720"
	aria-label={clip.title}
>
	<source src={webm} type="video/webm" />
	<source src={mp4} type="video/mp4" />
</video>
