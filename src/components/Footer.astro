---
import { GITHUB_URL, WIKI_URL } from '../consts';

const today = new Date();
---

<footer>
	<div class="mx-auto flex max-w-6xl flex-col gap-4 px-5 py-10 text-sm text-hippo-silver md:flex-row md:items-center md:justify-between">
		<p class="m-0">&copy; {today.getFullYear()} HippOS. Public beta. Built to play.</p>
		<div class="flex flex-wrap gap-4 font-semibold">
			<a class="text-hippo-silver no-underline hover:text-white" href="/about">About</a>
			<a class="text-hippo-silver no-underline hover:text-white" href={WIKI_URL}>Wiki</a>
			<a class="text-hippo-silver no-underline hover:text-white" href={GITHUB_URL}>GitHub</a>
			<a class="text-hippo-silver no-underline hover:text-white" href="/discord">Discord</a>
		</div>
	</div>
</footer>
<style>
	footer {
		border-top: 1px solid rgba(199, 203, 212, 0.1);
		background: rgba(3, 4, 10, 0.82);
	}
</style>
